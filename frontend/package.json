{
  "name": "safeloop-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-token-literals.mjs && node scripts/check-locale-keys.mjs && eslint app components --ext .tsx --max-warnings 0 && next build",
    "lint:tokens": "node scripts/check-token-literals.mjs",
    "lint:locales": "node scripts/check-locale-keys.mjs",
    "lint:i18n": "eslint app components --ext .tsx --max-warnings 0",
    "generate-state-machine": "node scripts/generate-state-machine.mjs",
    "start": "next start",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@heroicons/react": "2.2.0",
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "next-intl": "4.13.7",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@types/qrcode": "1.5.6",
    "@typescript-eslint/parser": "8.67.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "eslint-plugin-react": "7.37.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "jsdom": "25.0.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
